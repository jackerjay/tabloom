{
  "manifest_version": 3,
  "name": "织页 TabLoom",
  "version": "0.4.0",
  "description": "织页 TabLoom：连接本机多 Agent CLI，智能按主题语义分组标签页、生成摘要、防重拦截、休眠省内存并支持全局秒搜。",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "tabGroups", "storage", "sidePanel", "alarms", "favicon", "bookmarks", "history", "sessions", "scripting"],
  "optional_permissions": ["nativeMessaging"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "打开 织页 TabLoom 侧边栏" },
  "side_panel": { "default_path": "sidepanel.html" },
  "chrome_url_overrides": { "newtab": "home.html" },
  "commands": {
    "search-tabs": {
      "suggested_key": { "default": "Ctrl+K", "mac": "Command+K" },
      "description": "打开搜索（标签 / 书签 / Google）"
    }
  },
  "web_accessible_resources": [{ "resources": ["search.html"], "matches": ["http://*/*", "https://*/*"] }],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}